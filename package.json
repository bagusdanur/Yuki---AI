    "test:workspace": "node scripts/test-workspace-security.mjs",
    "test:agent-progress": "node scripts/test-agent-progress.mjs",
    "test:agent-runs": "node scripts/test-agent-runs.mjs",
    "test:agent-planner": "node scripts/test-agent-planner.mjs",
